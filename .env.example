# Copy to .env and fill in values before running
# NEVER commit .env to version control

# Server-side proxy target (used by Next.js rewrites in next.config.ts)
BACKEND_URL=http://localhost:8000

# Client-side backend URL (set when port-forwarding to bypass server proxy)
# Uncomment when using: runai port-forward medw-backend --ports 8000:8000
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# NIM inference service
NIM_BASE_URL=http://nim:8000/v1
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
NIM_API_KEY=your-nim-api-key-here
NIM_TIMEOUT=120

# NIM warmup configuration
NIM_WARMUP_ENABLED=true
NIM_WARMUP_RETRIES=120
NIM_WARMUP_RETRY_DELAY_SECONDS=25

# NGC API key (for NIM model download - used in Run:ai deployment)
NGC_API_KEY=your-ngc-api-key-here

# ChromaDB vector database
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# RAG Debug System — enables /api/v1/rag/debug/* introspection endpoints
# Set to true only in development/staging. NEVER enable in production.
RAG_DEBUG_ENABLED=false

# Queue configuration (SSE triage queue)
QUEUE_MAX_ENTRIES=1000
QUEUE_PROCESSING_TIMEOUT=300
